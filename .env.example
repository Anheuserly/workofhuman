# =====================================================================
# The Work of Human - Environment Configuration
# =====================================================================

# 1. PostgreSQL Database VPS Connection
DATABASE_URL=postgresql://postgres:AnheVps2022@vps.amcmep.in:5432/workofhuman

# 2. Site Domain
NEXT_PUBLIC_APP_URL=https://theworkofhuman.com

# 3. Windows Server PC Local Disk Storage (Self-Hosted - No Cloud Buckets Needed)
# Default is ./public/uploads, or specify any drive/folder on your Windows Server:
# UPLOAD_DIR="D:\\workofhuman\\uploads"
# UPLOAD_DIR="C:\\inetpub\\wwwroot\\media"

# Media streaming route (default: /api/media):
# MEDIA_BASE_URL="/api/media"
# Or if served directly via IIS/Nginx virtual directory:
# MEDIA_BASE_URL="/uploads"
# Or a dedicated subdomain:
# MEDIA_BASE_URL="https://media.theworkofhuman.com"

# Max Upload Size in MB (default: 250MB for video/audio)
MAX_UPLOAD_SIZE_MB=250
