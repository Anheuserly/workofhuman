# =====================================================================
# The Work of Human - Environment Configuration
# =====================================================================

# 1. PostgreSQL Database VPS Connection
DATABASE_URL=postgresql://postgres:AnheVps2022@vps.amcmep.in:5432/workofhuman

# 2. Site Domain
NEXT_PUBLIC_APP_URL=https://theworkofhuman.com

# ---------------------------------------------------------------------
# 3. Media Storage (Self-Hosted on your Server / VPS - NO Cloudflare)
# ---------------------------------------------------------------------

# --- OPTION A: Standalone VPS Media Service (Recommended for Option 2) ---
# Direct streaming to VPS SSD disk via services/media-server
# Set this in your Cloudflare dashboard environment variables:
NEXT_PUBLIC_VPS_MEDIA_URL=http://vps.amcmep.in:8080

# --- OPTION B: Direct Windows Server Disk (Zero Software Needed) ---
# Media files are saved directly onto your Windows hard drive.
# Requires only Node.js!
UPLOAD_DIR="D:\\workofhuman\\uploads"
MEDIA_BASE_URL="/api/media"
MAX_UPLOAD_SIZE_MB=250

# --- OPTION B: MinIO (If you run MinIO on your VPS or Windows Server) ---
# If you install/run MinIO on your VPS (e.g. vps.amcmep.in:9000) or on Windows:
# MINIO_ENDPOINT="http://vps.amcmep.in:9000"
# MINIO_ACCESS_KEY="your-minio-access-key"
# MINIO_SECRET_KEY="your-minio-secret-key"
# MINIO_BUCKET="workofhuman"
# MINIO_PUBLIC_URL="http://vps.amcmep.in:9000/workofhuman"
